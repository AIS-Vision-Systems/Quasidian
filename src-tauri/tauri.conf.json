{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quasidian",
  "version": "1.0.1",
  "identifier": "com.quasidian.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quasidian",
        "width": 1200,
        "height": 800,
        "theme": "Dark",
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost 'self' https://api.github.com; font-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost 'self' ws://localhost:1420 ws://localhost:1421 https://api.github.com; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AIS Vision Systems",
    "copyright": "© 2026 AIS Vision Systems",
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./quasidian.desktop"
      },
      "rpm": {
        "desktopTemplate": "./quasidian.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
